rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCashier() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'cashier'];
    }

    // ─── Users collection (roles) ────────────────────────────────────────────
    // Only admins can read/write user roles
    match /users/{uid} {
      allow read:  if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ─── Tables ──────────────────────────────────────────────────────────────
    // Anyone can read tables (needed for customer QR app to open sessions)
    // Only staff can update tables
    match /tables/{tableId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAuthenticated() || true; // customer app needs to update table status
      allow delete: if isAdmin();
    }

    // ─── Sessions ────────────────────────────────────────────────────────────
    // Anyone can create/read sessions (customer opens session via QR)
    // Only staff can close/update sessions
    match /sessions/{sessionId} {
      allow read:   if true;
      allow create: if true;   // customer app creates sessions
      allow update: if true;   // customer & staff can update
      allow delete: if isAdmin();
    }

    // ─── Orders ──────────────────────────────────────────────────────────────
    // Anyone can create orders (customer places orders)
    // Anyone can read orders (KDS and customer tracker)
    // Only staff can update status
    match /orders/{orderId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;   // KDS staff updates status; customer doesn't update
      allow delete: if isAdmin();
    }

    // ─── Menu items ──────────────────────────────────────────────────────────
    // Anyone can read menu (customer app browsing)
    // Only admin can create/delete; cashier can update availability
    match /menu_items/{itemId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isCashier();
      allow delete: if isAdmin();
    }

    // ─── Ingredients ─────────────────────────────────────────────────────────
    match /ingredients/{ingId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isCashier();
      allow delete: if isAdmin();
    }

    // ─── Any other collection: deny by default ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
