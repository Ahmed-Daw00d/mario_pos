rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCashier() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'cashier'];
    }

    // ─── Users collection (roles) ────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ─── Tables ──────────────────────────────────────────────────────────────
    // Anyone can read tables (customer QR app needs to know table status)
    // Only authenticated users (customers opening sessions) can update
    // Only admin can create/delete tables
    match /tables/{tableId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAuthenticated() || request.auth == null; // customers update via session open
      allow delete: if isAdmin();
    }

    // ─── Sessions ────────────────────────────────────────────────────────────
    // Anyone can create/read sessions (customer opens session via QR)
    // Closing a session requires cashier role
    match /sessions/{sessionId} {
      allow read:   if true;
      allow create: if true;   // customer opens session
      allow update: if true;   // customer (bill request) and staff (close session)
      allow delete: if isAdmin();
    }

    // ─── Orders ──────────────────────────────────────────────────────────────
    // Customers can CREATE orders — but only staff can UPDATE status
    // Anyone can READ orders (KDS, customer tracker, receipts)
    match /orders/{orderId} {
      allow read:   if true;
      allow create: if true;           // customer places order
      allow update: if isCashier();    // only staff can change order status
      allow delete: if isAdmin();
    }

    // ─── Menu items ──────────────────────────────────────────────────────────
    // Anyone can read menu (customer browsing)
    // Only admin can create/delete; cashier can toggle availability
    match /menu_items/{itemId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isCashier();
      allow delete: if isAdmin();
    }

    // ─── Ingredients ─────────────────────────────────────────────────────────
    match /ingredients/{ingId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isCashier();
      allow delete: if isAdmin();
    }

    // ─── Any other collection: deny by default ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
